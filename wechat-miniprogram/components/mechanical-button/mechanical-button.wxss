.mech-wrapper {
  width: 616rpx;
  height: 616rpx;
  max-width: 308px;
  max-height: 308px;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  user-select: none;
}

.mono {
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
}

/* 1. 工业铸铝方型面板 */
.mech-plate-shadow {
  position: absolute;
  left: 3.25%;
  right: 3.25%;
  top: 5.2%;
  bottom: 1.3%;
  border-radius: 11.2%;
  background-color: rgba(0, 0, 0, 0.65);
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.55);
}

.mech-plate {
  position: absolute;
  inset: 3.25%;
  border-radius: 11.1%;
  background: linear-gradient(135deg, #383c42 0%, #25282d 35%, #1d2024 70%, #2b2f36 100%);
  overflow: hidden;
}

.mech-plate-bevel {
  position: absolute;
  inset: 0;
  border-radius: inherit;
  border: 3rpx solid rgba(255, 255, 255, 0.12);
  box-shadow:
    inset 2rpx 2rpx 2rpx rgba(255, 255, 255, 0.16),
    inset -2rpx -2rpx 4rpx rgba(0, 0, 0, 0.55);
  pointer-events: none;
}

/* 2. 四角沉头工业螺丝 */
.screw {
  position: absolute;
  width: 5.85%;
  height: 5.85%;
  border-radius: 50%;
  background: linear-gradient(135deg, #646970 0%, #282b30 100%);
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.78);
  display: flex;
  align-items: center;
  justify-content: center;
}

.screw-tl {
  left: 8.12%;
  top: 8.12%;
}

.screw-tr {
  right: 8.12%;
  top: 8.12%;
}

.screw-bl {
  left: 8.12%;
  bottom: 8.12%;
}

.screw-br {
  right: 8.12%;
  bottom: 8.12%;
}

.screw-slot {
  width: 68%;
  height: 3.5rpx;
  border-radius: 2rpx;
  background-color: #121316;
}

.screw-slot-tl {
  transform: rotate(35deg);
}

.screw-slot-tr {
  transform: rotate(62deg);
}

.screw-slot-bl {
  transform: rotate(89deg);
}

.screw-slot-br {
  transform: rotate(116deg);
}

/* 3. 车削滚花金属外护圈 */
.mech-bezel-shadow {
  position: absolute;
  width: 75.32%;
  height: 75.32%;
  left: 12.34%;
  top: 13.96%;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.72);
}

.mech-bezel {
  position: absolute;
  width: 72.73%;
  height: 72.73%;
  left: 13.64%;
  top: 13.64%;
  border-radius: 50%;
  background: linear-gradient(135deg, #6b7078 0%, #2f3339 35%, #1b1d21 70%, #525760 100%);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mech-knurl {
  position: absolute;
  inset: 0.7%;
  border-radius: 50%;
  background: repeating-conic-gradient(
    from 0deg,
    rgba(0, 0, 0, 0.45) 0deg 3deg,
    rgba(255, 255, 255, 0.14) 3deg 6deg
  );
}

.mech-bezel-face {
  position: relative;
  width: 87.5%;
  height: 87.5%;
  border-radius: 50%;
  background: linear-gradient(135deg, #6b7078 0%, #2f3339 35%, #1b1d21 70%, #525760 100%);
}

/* 4. 嵌入式环形 LED 状态指示灯 */
.mech-led-track {
  position: absolute;
  width: 66.88%;
  height: 66.88%;
  border-radius: 50%;
  background-color: #101215;
}

.mech-led-glow {
  position: absolute;
  width: 69.15%;
  height: 69.15%;
  border-radius: 50%;
  transition: opacity 0.22s ease;
}

.mech-led-arc {
  position: absolute;
  width: 66.62%;
  height: 66.62%;
  border-radius: 50%;
  transition: opacity 0.22s ease;
}

/* 5. 按钮沉孔井道 */
.mech-well {
  position: absolute;
  width: 62.34%;
  height: 62.34%;
  border-radius: 50%;
  background: radial-gradient(circle, #0a0b0d 0%, #181a1e 100%);
}

/* 6. 复古机械大键帽 */
.mech-cap-group {
  position: absolute;
  width: 55.84%;
  height: 55.84%;
  left: 22.08%;
  top: 21.1%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
  transform: translateY(0) scale(1);
}

.mech-cap-group.is-pressed {
  transform: translateY(13rpx) scale(0.975);
}

.mech-cap-shadow {
  position: absolute;
  width: 102.3%;
  height: 102.3%;
  left: -1.15%;
  top: 12.8%;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.65);
  transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.18s ease;
}

.mech-cap-group.is-pressed .mech-cap-shadow {
  transform: translateY(-10rpx);
  opacity: 0.66;
}

.mech-cap-skirt {
  position: absolute;
  width: 100%;
  height: 100%;
  left: 0;
  top: 7%;
  border-radius: 50%;
  background: linear-gradient(180deg, #6a1111 0%, #3e0909 100%);
  transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.mech-cap-group.is-pressed .mech-cap-skirt {
  transform: translateY(-9rpx);
}

.mech-cap-top {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: radial-gradient(circle at 32% 30%, #d6302b 0%, #b31f1b 55%, #7d1210 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.mech-cap-dish {
  position: absolute;
  width: 78%;
  height: 78%;
  border-radius: 50%;
  background: linear-gradient(
    135deg,
    rgba(107, 14, 12, 0.75) 0%,
    rgba(201, 42, 37, 0.35) 50%,
    rgba(255, 138, 128, 0.2) 100%
  );
  pointer-events: none;
}

.mech-cap-rim {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 4rpx solid transparent;
  box-shadow:
    inset 3rpx 3rpx 4rpx rgba(255, 255, 255, 0.32),
    inset -3rpx -3rpx 5rpx rgba(0, 0, 0, 0.35);
  transition: opacity 0.18s ease;
  pointer-events: none;
}

.mech-cap-group.is-pressed .mech-cap-rim {
  opacity: 0.55;
}

.mech-label-wrap {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.mech-label {
  font-weight: 700;
  line-height: 1;
}

.mech-label-idle {
  font-size: 52rpx;
  letter-spacing: 4rpx;
}

.mech-label-count {
  font-size: 108rpx;
}

.mech-label-count-burst {
  font-size: 92rpx;
}

.mech-label-symbol {
  font-size: 80rpx;
}

.mech-sublabel {
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  line-height: 1;
}
